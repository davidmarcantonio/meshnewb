{
  "name": "meshprov",
  "version": "0.3.0",
  "description": "Flash and configure a Meshtastic node from the browser, with California community presets.",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python3 -m http.server 8000 --directory dist",
    "build:fake-node": "esbuild tests/fake-node.js --bundle --format=iife --alias:os=./shims/node.js --alias:path=./shims/node.js --alias:util=./shims/node.js \"--banner:js=globalThis.process??={env:{},cwd:()=>\\\"\\\"};globalThis.Buffer??={isBuffer:()=>false};\" --outfile=tests/fake-node.bundle.js --log-level=warning",
    "test": "npm run build && npm run build:fake-node && python3 tests/run.py \"$(node tests/mkurl.mjs)\" && python3 tests/csp_probe.py"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@meshtastic/core": "2.6.7",
    "@meshtastic/transport-web-serial": "0.2.5",
    "esptool-js": "0.5.7"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
